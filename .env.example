# ==========================================================
# Configuración de AutoMax
# Copie este archivo como ".env" y escriba sus propios datos.
# ==========================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automax_db
DB_USER=postgres
DB_PASSWORD=su_contraseña

# Puerto del servidor web
PORT=3000

# Clave para firmar la cookie de sesión. Escriba un texto largo cualquiera.
SESSION_SECRET=cambie-este-texto-por-uno-largo-y-propio
